#name "Mega Clicker"
// Попробуем инициализировать переменную, 
// если она есть в db, интерпретатор может её подцепить
int count = 0
int record = 0 

while hold ok == 0 do
  clear
  ui_rama "RECORD BREAKER" 1 1 1 1
  
  set_cursor 0 2
  print "Record: "
  print record
  
  set_scale 2
  set_cursor 45 4
  print count
  
  if click right == 1 then 
    count = count + 1 
  end
  
  if count > record then
    record = count
    // Тут должна быть команда сохранения, 
    // но в твоём Cat# это обычно происходит при exit
  end
  
  update
  delay 50
end
exit
